<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/resultTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pick a door!"
        android:textSize="32sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/door1Button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/door1Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Door 1"
        android:textSize="28sp"
        app:layout_constraintTop_toBottomOf="@id/resultTextView"
        app:layout_constraintBottom_toTopOf="@id/door2Button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <Button
        android:id="@+id/door2Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Door 2"
        android:textSize="28sp"
        app:layout_constraintTop_toBottomOf="@id/door1Button"
        app:layout_constraintBottom_toTopOf="@id/door3Button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/door3Button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Door 3"
        android:textSize="28sp"
        app:layout_constraintTop_toBottomOf="@id/door2Button"
        app:layout_constraintBottom_toTopOf="@id/scoreTextView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/scoreTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wins: 0; Losses: 0"
        android:textSize="24sp"
        app:layout_constraintTop_toBottomOf="@id/door3Button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>